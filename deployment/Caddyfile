{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size {$GATEWAY_MAX_REQUEST_BODY}
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'self' blob:; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://lh3.googleusercontent.com https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com/gsi/; frame-src 'self' blob: https://accounts.google.com/gsi/; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@internal path /internal/*
	handle @internal {
		respond 404
	}

	@uploads path /uploads/*
	handle @uploads {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
			}
		}
	}

	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		file_server
	}
}
