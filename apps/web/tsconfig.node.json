{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "e2e/**/*.ts",
    "src/app/workspace-navigation/workspace-navigation.context.ts",
    "src/app/workspace-navigation/workspace-navigation.types.ts",
    "src/features/theme/lib/*.ts",
    "src/features/theme/providers/ThemeProvider.tsx",
    "src/features/theme/types/*.ts",
    "src/lib/config/runtime-config.types.ts",
    "src/lib/config/test-runtime-config.ts"
  ]
}
