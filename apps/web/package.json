{
  "name": "@life-admin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "storybook:test": "vitest run --project=storybook",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "test:accessibility": "playwright test e2e/accessibility.spec.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-tooltip": "1.2.12",
    "@tanstack/react-query": "5.101.2",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-vitest": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.2",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "storybook": "10.5.0"
  }
}
