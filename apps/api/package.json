{
  "name": "@life-admin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "extraction:evaluate": "tsx src/modules/document-extraction/tools/evaluate-extraction.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "file-type": "22.0.1",
    "google-auth-library": "10.5.0",
    "helmet": "8.1.0",
    "multer": "2.2.0",
    "pdfjs-dist": "6.1.200",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.1.28",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.9",
    "@types/supertest": "6.0.3",
    "dotenv": "17.4.2",
    "dotenv-expand": "12.0.1",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "ts-loader": "9.5.4",
    "tsx": "4.21.0",
    "vitest": "4.1.10"
  }
}
