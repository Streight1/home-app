generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  TRASHED
}

enum StoredFileDeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentType {
  GENERAL
  INVOICE
  RECEIPT
  CONTRACT
  WARRANTY
  INSURANCE
  MANUAL
  VEHICLE_DOCUMENT
  PROPERTY_DOCUMENT
  UTILITY_BILL
  PERSONAL
  OTHER
}

enum ExtractionType {
  STRUCTURED_DATA
}

enum ExtractionJobStatus {
  QUEUED
  PROCESSING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
  CANCELLED
}

enum ExtractionFieldStatus {
  PROPOSED
  ACCEPTED
  EDITED
  REJECTED
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
  ARCHIVED

  @@map("AgendaTaskStatus")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT

