  sortOrder               Int             @default(0)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  packTemplate            PackTemplate    @relation(fields: [packTemplateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gearItem                GearItem?       @relation(fields: [gearItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  category                GearCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  defaultAssignedUser     User?           @relation("PackTemplateItemDefaultAssignee", fields: [defaultAssignedUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tripPackItems           TripPackItem[]

  @@unique([packTemplateId, sortOrder])
  @@index([gearItemId])
  @@index([categoryId])
  @@index([defaultAssignedUserId])
}

model Trip {
  id                        String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId               String                         @db.Uuid
  title                     String                         @db.VarChar(200)
  description               String?                        @db.VarChar(3000)
  tripType                  ExpeditionTripType
  status                    ExpeditionTripStatus           @default(PLANNING)
  startsOn                  DateTime                       @db.Date
  endsOn                    DateTime                       @db.Date
  locationLabel             String?                        @db.VarChar(300)
  overnightCount            Int                            @default(0)
  targetBaseWeightGrams     Int?
  notes                     String?                        @db.VarChar(5000)
  createdFromTemplateId     String?                        @db.Uuid
  createdByUserId           String                         @db.Uuid
  updatedByUserId           String                         @db.Uuid
  archivedAt                DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  household                 Household                      @relation(fields: [householdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdFromTemplate       PackTemplate?                  @relation(fields: [createdFromTemplateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy                 User                           @relation("TripCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy                 User                           @relation("TripUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  participants              TripParticipant[]
  packItems                 TripPackItem[]
  taskLinks                 TripTaskLink[]
  readinessAcknowledgements TripReadinessAcknowledgement[]

  @@index([householdId, archivedAt])
  @@index([householdId, status, startsOn])
  @@index([startsOn])
  @@index([createdFromTemplateId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model TripParticipant {
  tripId          String              @db.Uuid
  userId          String              @db.Uuid
  role            TripParticipantRole @default(PARTICIPANT)
  createdByUserId String              @db.Uuid
  createdAt       DateTime            @default(now())
  trip            Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user            User                @relation("TripParticipantUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User                @relation("TripParticipantCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([tripId, userId])
  @@index([userId])
  @@index([createdByUserId])
}

model TripPackItem {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId                  String            @db.Uuid
  sourceTemplateItemId    String?           @db.Uuid
  gearItemId              String?           @db.Uuid
  nameSnapshot            String            @db.VarChar(200)
  categoryNameSnapshot    String?           @db.VarChar(100)
  quantityDecimal         Decimal           @default(1) @db.Decimal(12, 3)
  unitWeightGramsSnapshot Int               @default(0)
  loadType                GearLoadType
  criticality             GearCriticality
  isShared                Boolean           @default(false)
  assignedUserId          String?           @db.Uuid
  packingStatus           GearPackingStatus @default(PLANNED)
  packLocationLabel       String?           @db.VarChar(120)
  notes                   String?           @db.VarChar(2000)
  packedAt                DateTime?
  packedByUserId          String?           @db.Uuid
  reviewOutcome           GearReviewOutcome @default(NOT_REVIEWED)
  reviewNotes             String?           @db.VarChar(2000)
  sortOrder               Int               @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  trip                    Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceTemplateItem      PackTemplateItem? @relation(fields: [sourceTemplateItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  gearItem                GearItem?         @relation(fields: [gearItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedUser            User?             @relation("TripPackItemAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  packedBy                User?             @relation("TripPackItemPackedBy", fields: [packedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  taskLinks               TripTaskLink[]

  @@unique([tripId, sortOrder])
  @@index([tripId, packingStatus])
  @@index([sourceTemplateItemId])
  @@index([gearItemId])
  @@index([assignedUserId])
  @@index([packedByUserId])
}

model TripTaskLink {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId          String        @db.Uuid
  tripPackItemId  String?       @db.Uuid
  taskId          String        @db.Uuid
  createdByUserId String        @db.Uuid
  removedAt       DateTime?
  createdAt       DateTime      @default(now())
  trip            Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tripPackItem    TripPackItem? @relation(fields: [tripPackItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User          @relation("TripTaskLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tripId, removedAt])
  @@index([tripPackItemId, removedAt])
  @@index([taskId, removedAt])
  @@index([createdByUserId])
}

model TripReadinessAcknowledgement {
  tripId               String   @db.Uuid
  ruleCode             String   @db.VarChar(80)
  acknowledgedByUserId String   @db.Uuid
  acknowledgedAt       DateTime @default(now())
  trip                 Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  acknowledgedBy       User     @relation("TripReadinessAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([tripId, ruleCode])
  @@index([acknowledgedByUserId])
}
