  G
  KG
  ML
  L
  TSP
  TBSP
  CUP
  PIECE
  PACKAGE
  SLICE
  PINCH
  AS_NEEDED
  CUSTOM
}

enum RecipeDocumentRelationType {
  PHOTO
  SOURCE
  PRINTED_RECIPE
  OTHER
}

enum MealType {
  BREAKFAST
