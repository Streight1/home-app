# =============================================================================
# Application
# =============================================================================

NODE_ENV=development

API_PORT=3000
WEB_PORT=5173

WEB_ORIGIN=http://localhost:${WEB_PORT}
TRUST_PROXY=false

# Staging/production deployment. Pro lokální vývoj se nepoužívají.
APP_DOMAIN=homeapp.example.cz
APP_PROTOCOL=https
APP_RELEASE=local-development
APP_ENV_LABEL=
ACME_EMAIL=admin@example.com
APP_RUNTIME_UID=1000
APP_RUNTIME_GID=1000
GATEWAY_MAX_REQUEST_BODY=30MB
BACKUP_RETENTION_COUNT=7
VPS_MIN_FREE_BYTES=5368709120

# =============================================================================
# Public browser configuration
#
# Všechny hodnoty s prefixem VITE_ jsou součástí frontendového bundlu.
# Nikdy sem nepatří hesla, session tokeny ani interní tajemství.
# =============================================================================

VITE_API_URL=http://localhost:${API_PORT}/api/v1
VITE_MAX_UPLOAD_BYTES=${MAX_UPLOAD_BYTES}
VITE_FINANCE_IMPORT_MAX_FILE_BYTES=${FINANCE_IMPORT_MAX_FILE_BYTES}
VITE_APP_ENV_LABEL=${APP_ENV_LABEL}

# =============================================================================
# Google authentication
# =============================================================================

# Google OAuth Client ID není tajemství a používá jej frontend i backend.
GOOGLE_CLIENT_ID=replace-with-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# V development může být seznam prázdný.
# V production musí obsahovat minimálně jednu adresu.
GOOGLE_ALLOWED_EMAILS=owner@example.com,member@example.com

# Jednoduchý sdílený household režim. Owner se musí přihlásit jako první.
SINGLE_HOUSEHOLD_MODE=true
SINGLE_HOUSEHOLD_OWNER_EMAIL=owner@example.com
SINGLE_HOUSEHOLD_NAME=Naše domácnost

# =============================================================================
# PostgreSQL
# =============================================================================

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=homeapp
POSTGRES_USER=homeapp
POSTGRES_PASSWORD=homeapp_local_password

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# =============================================================================
# Sessions and CSRF
# =============================================================================

SESSION_COOKIE_NAME=homeapp_session
CSRF_COOKIE_NAME=homeapp_csrf
SESSION_TTL_DAYS=30

# Minimálně 32 náhodných znaků.
INTERNAL_HEALTH_TOKEN=replace-with-at-least-32-random-characters

# =============================================================================
# Local file storage
# =============================================================================

UPLOAD_ROOT=./uploads

# 25 MiB
MAX_UPLOAD_BYTES=26214400

# CSV bankovních výpisů: 20 MiB, 100 000 řádků, rozpracovaná session 24 hodin.
FINANCE_IMPORT_MAX_FILE_BYTES=20971520
FINANCE_IMPORT_MAX_ROWS=100000
FINANCE_IMPORT_SESSION_TTL_HOURS=24

# =============================================================================
# Mapy.com REST API (pouze backend)
# =============================================================================

MAPY_API_ENABLED=false
MAPY_API_KEY=replace-with-mapy-api-key
MAPY_API_TIMEOUT_MS=5000
MAPY_SUGGEST_MIN_QUERY_LENGTH=3
MAPY_SUGGEST_MAX_RESULTS=8
MAPY_DEFAULT_LANGUAGE=cs
